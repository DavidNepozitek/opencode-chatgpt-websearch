{
  "name": "opencode-chatgpt-websearch",
  "version": "1.1.1",
  "description": "Native OpenCode V2 web search using your existing ChatGPT subscription",
  "keywords": [
    "chatgpt",
    "opencode",
    "opencode-plugin",
    "websearch"
  ],
  "homepage": "https://github.com/DavidNepozitek/opencode-chatgpt-websearch#readme",
  "bugs": {
    "url": "https://github.com/DavidNepozitek/opencode-chatgpt-websearch/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DavidNepozitek/opencode-chatgpt-websearch.git"
  },
  "files": [
    "server.ts",
    "src",
    "README.md",
    "LICENSE.md",
    "SECURITY.md"
  ],
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./server": "./server.ts"
  },
  "scripts": {
    "compile": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings server.ts src tests",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test && pnpm compile",
    "audit:dependencies": "pnpm audit --audit-level=moderate"
  },
  "devDependencies": {
    "@opencode/plugin": "2.0.28",
    "@types/node": "22.20.5",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "packageManager": "pnpm@11.27.0"
}
